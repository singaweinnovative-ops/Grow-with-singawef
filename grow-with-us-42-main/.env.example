# Formspree endpoint used as a backup email notification for the contact
# form and newsletter signup (src/routes/contact.tsx, src/components/site/Footer.tsx).
# The database (Supabase, below) is the primary store for every form
# submission now; this is best-effort and a failure here never blocks a
# submission. Get one free at https://formspree.io.
VITE_FORMSPREE_ENDPOINT=

# Supabase project used to store every form submission on the site —
# contact, newsletter signup, report-a-concern, help-applying, the
# Journeyer/Guide application forms (including ID/CV file uploads),
# volunteer/companion, and programme join/collaborate forms.
# Submitted directly from the browser using the public anon key — safe to
# expose (VITE_ prefix). Security comes from Row Level Security policies
# in supabase/schema.sql: anon can INSERT only, never read, update or
# delete. Run supabase/schema.sql once in the SQL Editor before using this.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Zazi, the SINGAWE assistant chat widget (src/components/site/ZaziChat.tsx,
# src/routes/api/zazi.ts). Server-only — never exposed to the browser.
GEMINI_API_KEY=
