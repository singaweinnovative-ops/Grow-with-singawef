# Copy to .env for local development only. NEVER put real values in this
# file — it is committed to git. Production values live in the host's
# server settings (Cloudflare: Workers & Pages -> this worker -> Settings ->
# Variables and Secrets). See supabase/README.md -> "Deployment settings".
#
# Two kinds of setting:
#   VITE_*  -> public, baked into the browser bundle AT BUILD TIME. Safe to
#              expose, but changing one needs a rebuild.
#   others  -> server-only secrets, read at request time. Add them as
#              encrypted "Secret" values on the host, never as VITE_*.

# ---------------------------- Public (VITE_) ----------------------------

# The site's public address, used for share previews, sitemap and
# structured data, e.g. https://singawefoundation.org (no trailing slash).
VITE_SITE_URL=

# Supabase project shared with the management website. The anon key is
# public by design: Row Level Security (supabase/schema.sql) only lets it
# READ published content. Form submissions go through /api/submit instead.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile spam protection for every form — the *site key*
# (public). Create a widget at dash.cloudflare.com -> Turnstile.
VITE_TURNSTILE_SITE_KEY=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Loaded only after a
# visitor clicks "Accept cookies". Leave empty to disable analytics.
VITE_GA_MEASUREMENT_ID=

# Google Search Console "HTML tag" verification code (just the content="…"
# value). Optional — DNS verification in Search Console works without it.
VITE_GOOGLE_SITE_VERIFICATION=

# Optional backup email copy of contact/newsletter submissions.
VITE_FORMSPREE_ENDPOINT=

# ------------------------- Server-only secrets --------------------------

# Service-role key: lets /api/submit store form submissions and uploads
# after the spam checks pass, and powers the shared rate limiter.
# Supabase -> Project Settings -> API -> service_role. Never VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile *secret key* (pairs with VITE_TURNSTILE_SITE_KEY).
TURNSTILE_SECRET_KEY=

# Zazi chat assistant (src/routes/api/zazi.ts). Create at
# https://aistudio.google.com/apikey — restrict it to the Generative
# Language API.
GEMINI_API_KEY=
# Optional model override.
GEMINI_MODEL=
